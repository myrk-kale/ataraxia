{
  "name": "ataraxia",
  "private": true,
  "version": "0.0.0",
  "description": "Desktop environment for agent-assisted software development",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "pnpm --filter @ataraxia/desktop dev",
    "build": "pnpm --filter @ataraxia/desktop build",
    "lint": "pnpm --filter @ataraxia/desktop lint",
    "typecheck": "pnpm --filter @ataraxia/desktop typecheck",
    "tauri": "node scripts/tauri.mjs",
    "tauri:dev": "pnpm tauri dev",
    "tauri:build": "pnpm tauri build",
    "test": "pnpm --filter @ataraxia/desktop test"
  },
  "engines": {
    "node": ">=22"
  }
}
