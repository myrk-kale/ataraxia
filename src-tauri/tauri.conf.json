{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ataraxia",
  "version": "0.24.0",
  "identifier": "app.ataraxia.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @ataraxia/desktop dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter @ataraxia/desktop build",
    "frontendDist": "./web"
  },
  "app": {
    "windows": [
      {
        "title": "Ataraxia",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 22, "y": 24 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:; object-src http://127.0.0.1:*; frame-src http://127.0.0.1:*; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "devCsp": null,
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Desktop environment for agent-assisted software development",
    "longDescription": "Ataraxia puts coding agents (Claude Code, Codex, OpenCode) in a keyboard-first workspace: chat, a code review ranked by what needs a look, decisions kept as threads, flow diagrams and a terminal.",
    "copyright": "Copyright (c) 2026 Kale",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "devel"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    }
  },
  "mainBinaryName": "ataraxia",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ0NTIxQjc0NEFBMTNEMzEKUldReFBhRktkQnRTMURrS2JSSUoxNDVmNGdCMnVQS3VpbnFqbkFTYnZPUjFIZmFSaDIwbnpXS3YK",
      "endpoints": [
        "https://github.com/myrk-kale/ataraxia/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
